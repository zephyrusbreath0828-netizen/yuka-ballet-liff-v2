rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ロール取得ヘルパー（LINE userId = ユーザーUID） */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }
    function isTeacher() {
      return isSignedIn() && getUserData().role == 'teacher';
    }
    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    /* users: 自分のドキュメントは読み取り可 / 更新は管理者のみ（ロールは管理者のみ変更可） */
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'student';
      // 自分のドキュメントでも role / memberNumber / className は変更不可（管理者のみ）
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.memberNumber == resource.data.memberNumber
                        && request.resource.data.className == resource.data.className);
      allow delete: if isAdmin();
    }

    /* lessons: 読み取りはサインイン済み / 作成・更新・削除は管理者のみ */
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /* lessonReservations: 自分の予約の作成・読み取り可 / 出席状態の更新は管理者・講師 */
    match /lessonReservations/{reservationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // 欠席キャンセル（削除）は本人のみ / attendanceStatus の更新は管理者・講師のみ
      allow update: if isAdminOrTeacher();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /* announcements: 読み取りはサインイン済み / 作成・削除は管理者のみ */
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /* payments: 本人は読み取りのみ / 作成・更新・削除は管理者のみ */
    match /payments/{paymentId} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    /* test_connection: 接続テスト用（書き込み可 / 読み取りは管理者のみ） */
    match /test_connection/{docId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
